
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ScheduledEmail {
  id             String   @id @default(cuid())
  ownerGoogleId  String?
  recipient      String
  subject        String
  body           String
  scheduledAt    DateTime
  status         String   @default("SCHEDULED")
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([ownerGoogleId, status, scheduledAt])
}

model SlackConnection {
  id            String   @id @default(cuid())
  ownerGoogleId String   @unique
  teamId        String
  teamName      String
  accessToken   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([teamId])
}

model Contact {
  id            String   @id @default(cuid())
  ownerGoogleId String
  email         String
  firstName     String?
  lastName      String?
  company       String?
  jobTitle      String?
  notes         String?
  unsubscribed  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerGoogleId, email])
  @@index([ownerGoogleId, createdAt])
  @@index([ownerGoogleId, company])
}
