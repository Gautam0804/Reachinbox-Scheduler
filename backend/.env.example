PORT=4000
FRONTEND_URL=http://localhost:5173

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=ReachInbox Scheduler <your-email@example.com>

# Email worker and rate limiting
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=1000
GLOBAL_HOURLY_LIMIT=100
PER_SENDER_HOURLY_LIMIT=30
RATE_LIMIT_TEST_MODE=false

# Slack notifications
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
SLACK_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Application session
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Bull Board admin access
ADMIN_EMAILS=admin@example.com

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
